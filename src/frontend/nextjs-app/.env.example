NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Server-only override for RSC/SSR fetches (e.g. inside docker-compose,
# where the frontend container must reach the gateway by its service name
# rather than localhost). Leave unset for plain `npm run dev`. See
# lib/api/client.ts and deployments/docker-compose.yaml.
API_BASE_URL_INTERNAL=

# Firebase Web SDK config — leave blank to use the mock login flow that
# pairs with identity-service's AUTH_FIREBASE_MODE=mock (see lib/firebase.ts).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
