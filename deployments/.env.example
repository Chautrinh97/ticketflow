# Copy to deployments/.env (gitignored) and adjust as needed for local dev.
# docker compose automatically reads deployments/.env when run from that directory.

POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow
POSTGRES_DB=ticketflow
MONGO_DB_NAME=ticketflow

# Shared HS256 secret: identity-service signs access tokens with it, every
# other service + the API Gateway verify locally with it. Change for anything
# beyond local dev.
JWT_SIGNING_KEY=dev-secret-change-me

# mock (default): identity-service accepts a locally-crafted base64(JSON)
# "Firebase token" instead of calling real Firebase — see
# src/services/identity-service/internal/firebase/mock.go. Set to "real" and
# provide FIREBASE_CREDENTIALS_FILE once you have a Firebase project.
AUTH_FIREBASE_MODE=mock
FIREBASE_CREDENTIALS_FILE=

# false for local http dev; set true once served over https.
COOKIE_SECURE=false

# Must match the frontend's own origin exactly (CORS + credentials).
ALLOWED_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
